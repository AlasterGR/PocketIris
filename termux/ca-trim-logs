#!/data/data/com.termux/files/usr/bin/bash
# Keep PocketIris's log files small and fresh: none bigger than LOG_MAX_MB, none untouched for longer than LOG_MAX_DAYS.
# The limits come from /sdcard/Documents/ca/settings.conf (defaults: 5 MB and 180 days). Use -v to see what it does.
verbose=0
[ "${1:-}" = "-v" ] && verbose=1
LOG_MAX_MB=5
LOG_MAX_DAYS=180
conf=/sdcard/Documents/ca/settings.conf
#  Read the user's limits when the settings file exists; otherwise the defaults above stay.
[ -r "$conf" ] && . "$conf"
#  Ignore values that are not plain whole numbers, so a typo in the settings file can never cut or delete logs by mistake.
case "$LOG_MAX_MB" in ''|*[!0-9]*) LOG_MAX_MB=5 ;; esac
case "$LOG_MAX_DAYS" in ''|*[!0-9]*) LOG_MAX_DAYS=180 ;; esac
[ "$LOG_MAX_MB" -ge 1 ] || LOG_MAX_MB=5
[ "$LOG_MAX_DAYS" -ge 1 ] || LOG_MAX_DAYS=180
max=$((LOG_MAX_MB * 1024 * 1024))

#  Prints a line only when -v was given.
say() { [ "$verbose" = 1 ] && echo "$@"; return 0; }

#  Lists every log file that PocketIris's parts write.
list_logs() {
  ls "$HOME"/*.log "$HOME/ya-android/server.log" /sdcard/Documents/ca/run.log 2>/dev/null
  find "$HOME/.yep-anywhere/logs" -type f 2>/dev/null
}

#  Says whether a file can safely be cut now: yes when no program has it open, or every program that has it open adds to its end (append mode).
#  A program that writes from its own remembered position would leave a gap of empty space behind after a cut.
safe_to_cut() {
  local target="$1" fd pid n flags
  for fd in /proc/[0-9]*/fd/*; do
    [ "$(readlink "$fd" 2>/dev/null)" = "$target" ] || continue
    pid=${fd#/proc/}; pid=${pid%%/*}; n=${fd##*/}
    flags=$(awk '/^flags:/ {print $2}' "/proc/$pid/fdinfo/$n" 2>/dev/null)
    #  Not in append mode (the O_APPEND bit is 02000 in octal) means it is not safe.
    [ -n "$flags" ] && [ $(( 8#$flags & 8#2000 )) -ne 0 ] || return 1
  done
  return 0
}

checked=0; cut=0; removed=0; skipped=0
#  Look at each log file once: delete it when it is old, cut it back when it is big.
while IFS= read -r f; do
  [ -f "$f" ] || continue
  checked=$((checked + 1))

  #  A file nobody has written to for longer than the age limit is deleted.
  if [ -n "$(find "$f" -mtime +"$LOG_MAX_DAYS" 2>/dev/null)" ]; then
    rm -f "$f" && removed=$((removed + 1)) && say "deleted (older than $LOG_MAX_DAYS days): $f"
    continue
  fi
  size=$(stat -c %s "$f" 2>/dev/null || echo 0)

  #  A file over the size limit keeps only its newest part; it is cut in place, so a program that still writes to it carries on normally.
  if [ "$size" -gt "$max" ]; then
    #  A file that a running program writes to in a way that a cut would damage is left alone until that program restarts.
    if ! safe_to_cut "$f"; then
      skipped=$((skipped + 1)); say "too big but in use (cut after its program restarts): $f"
      continue
    fi
    if tail -c "$max" "$f" > "$f.tmp" && cat "$f.tmp" > "$f"; then
      cut=$((cut + 1)); say "cut to $LOG_MAX_MB MB (was $((size / 1024)) KB): $f"
    fi
    rm -f "$f.tmp"
  fi
done < <(list_logs)
say "Checked $checked log files: $cut cut to $LOG_MAX_MB MB, $skipped too big but in use, $removed deleted (older than $LOG_MAX_DAYS days)."
