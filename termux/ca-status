#!/data/data/com.termux/files/usr/bin/bash
# Show whether the server is running, which version is installed, and its process number.
#  Report whether the server answers.
if curl -s -o /dev/null --max-time 2 http://localhost:3400/; then echo "RUNNING at http://localhost:3400"; else echo "NOT running"; fi
echo "Installed: $(node -e 'console.log(require(process.env.HOME+"/ya-android/node_modules/yepanywhere/package.json").version)' 2>/dev/null)"
ps -ef | grep -E '[y]epanywhere/dist/cli.js' | awk '{print "process", $2}'
