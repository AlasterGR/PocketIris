#!/data/data/com.termux/files/usr/bin/bash
# Keep-previous-version and revert for Claude Code, without touching the official launcher ($PREFIX/bin/claude, from claude-code-android).
# The launcher runs the highest version in its versions folder that is not on its .blocklist and keeps the newest two. This command only
# edits that blocklist and keeps one extra copy of the known-good version outside the folder (the launcher never deletes it there).
#   ca-claude-version status            what is installed, what runs, what is skipped, what is kept
#   ca-claude-version check VERSION     does that version work for PocketIris (starts, reads the config, reaches the phone tool server)
#   ca-claude-version revert            skip the version that runs now, so the next start uses the previous one
#   ca-claude-version unrevert VERSION  stop skipping VERSION
#   ca-claude-version keep [VERSION]    keep a spare copy of VERSION (default: the known-good one from compat.json)
#   ca-claude-version restore-kept      put the spare copy back and skip every newer version
#   ca-claude-version guard [--dry-run] after a version change: check the new one; revert only if it fails and the previous one passes
#   ca-claude-version channel [latest|stable]  show or choose the update channel (kept in settings.conf as CLAUDE_CHANNEL)
#   ca-claude-version current           the version the launcher runs now
#   ca-claude-version install VERSION   fetch and install one official build (checksum, loader patch, test start), as the Updates button does
#   ca-claude-version follow [--quick]  (automatic mode, no longer scheduled; updates now come from the Updates button) apply the channel: "stable" holds back versions Anthropic has not marked stable and fetches the
#                                       stable build when the launcher would not; "latest" releases every hold. Never moves backwards.
#                                       --quick only keeps the launcher's own daily check from running (no network), for use at start.
# The folders and addresses can be changed for tests: CA_CLAUDE_VERSIONS, CA_CLAUDE_KEPT, CA_REVIEW_DIR, CA_COMPAT, CA_SETTINGS,
# CA_CLAUDE_TAGS_URL, CA_CLAUDE_DL, CA_CLAUDE_PATCHELF.
set -u
VERSIONS="${CA_CLAUDE_VERSIONS:-$HOME/.local/share/claude/versions}"
KEPT="${CA_CLAUDE_KEPT:-$HOME/.local/share/claude/kept}"
REVIEW="${CA_REVIEW_DIR:-/sdcard/_Review/claude-kept}"
COMPAT="${CA_COMPAT:-/sdcard/Documents/ca/compat.json}"
SETTINGS="${CA_SETTINGS:-/sdcard/Documents/ca/settings.conf}"
TAGS_URL="${CA_CLAUDE_TAGS_URL:-https://registry.npmjs.org/-/package/@anthropic-ai/claude-code/dist-tags}"
DL="${CA_CLAUDE_DL:-https://downloads.claude.ai/claude-code-releases}"
PATCHELF="${CA_CLAUDE_PATCHELF:-$PREFIX/glibc/bin/patchelf}"
GLIBC_LD="$PREFIX/glibc/lib/ld-linux-aarch64.so.1"
BLOCK="$VERSIONS/.blocklist"
GUARDED="$VERSIONS/.ca-guarded"
HELD="$VERSIONS/.ca-held"
LOG="${CA_CLAUDE_LOG:-$HOME/ca-claude-version.log}"

#  Writes one line to the screen and to the log.
say() { echo "$*"; echo "[$(date '+%F %T')] $*" >> "$LOG"; }
#  Lists the installed version numbers, newest first.
installed() { ls -1 "$VERSIONS" 2>/dev/null | grep -E '^[0-9]+\.[0-9]+\.[0-9]+$' | sort -Vr; }
#  True when the launcher skips this version.
skipped() { grep -qxF "$1" "$BLOCK" 2>/dev/null; }
#  Prints the version the launcher would run: the newest one it does not skip.
current() { for v in $(installed); do skipped "$v" || { echo "$v"; return; }; done; }
#  Prints the newest version below the given one that the launcher would accept.
previous() { local seen=0; for v in $(installed); do [ "$v" = "$1" ] && { seen=1; continue; }; [ "$seen" = 1 ] && ! skipped "$v" && { echo "$v"; return; }; done; }
#  Prints the known-good Claude Code version from compat.json, or nothing.
known_good() { node -e 'try{process.stdout.write(JSON.parse(require("fs").readFileSync(process.argv[1],"utf8")).knownGood.claudeCode||"")}catch(e){}' "$COMPAT" 2>/dev/null; }

#  Checks one version the way PocketIris needs it: it starts, reads the real settings, and reaches the phone tool server.
check() {
  local bin="$VERSIONS/$1" out
  #  A version that is not installed cannot pass.
  [ -x "$bin" ] || { echo "FAIL $1: not installed"; return 1; }
  out=$(cd "$HOME" && LD_PRELOAD= timeout 60 "$bin" --version 2>&1)
  #  The version must at least start and name itself.
  echo "$out" | grep -q "$1" || { echo "FAIL $1: does not start (${out:0:120})"; return 1; }
  out=$(cd "$HOME" && LD_PRELOAD= timeout 90 "$bin" mcp list 2>&1)
  #  It must read the settings and reach the app's tool server, which is what Claude's phone tools depend on.
  echo "$out" | grep -qE '^phone-browser:.*Connected' || { echo "FAIL $1: phone tools not reachable ($(echo "$out" | grep -m1 phone-browser || echo 'phone-browser not listed'))"; return 1; }
  echo "PASS $1"
}

#  Adds a version to the launcher's skip list (once).
block() { skipped "$1" || printf '%s\n' "$1" >> "$BLOCK"; }
#  Removes a version from the launcher's skip list (through a temporary file, so the list is never half written).
unblock() { grep -vxF "$1" "$BLOCK" > "$BLOCK.new" 2>/dev/null; mv -f "$BLOCK.new" "$BLOCK"; }
#  True when version $1 is newer than version $2.
newer() { [ "$1" != "$2" ] && [ "$(printf '%s\n%s\n' "$1" "$2" | sort -V | tail -1)" = "$1" ]; }
#  Prints the chosen channel: "stable" or "latest" (the default, which is what the launcher does on its own).
channel() { local c; c=$(grep -m1 '^CLAUDE_CHANNEL=' "$SETTINGS" 2>/dev/null | cut -d= -f2 | tr -d ' \r'); [ "$c" = stable ] && echo stable || echo latest; }
#  Prints one release tag ("stable" or "latest") from npm, or nothing when npm does not answer.
tag() { curl -fsSL --max-time 8 "$TAGS_URL" 2>/dev/null | node -e 'let s="";process.stdin.on("data",d=>s+=d).on("end",()=>{try{const v=JSON.parse(s)[process.argv[1]]||"";if(/^\d+\.\d+\.\d+$/.test(v))process.stdout.write(v)}catch(e){}})' "$1"; }

#  Fetches one official build the way the launcher does: official address, the release manifest's SHA-256 must match, loader patched,
#  and a test start that must not crash. Anything less and nothing is installed.
fetch() {
  local v="$1" tmp="$VERSIONS/$1.ca.tmp" want have
  curl -fsSL --max-time 300 "$DL/$v/linux-arm64/claude" -o "$tmp" 2>/dev/null && [ -s "$tmp" ] || { rm -f "$tmp"; say "Stable channel: could not download $v."; return 1; }
  want=$(curl -fsSL --max-time 8 "$DL/$v/manifest.json" 2>/dev/null | node -e 'let s="";process.stdin.on("data",d=>s+=d).on("end",()=>{try{process.stdout.write(JSON.parse(s).platforms["linux-arm64"].checksum||"")}catch(e){}})')
  have=$(sha256sum "$tmp" | cut -d' ' -f1)
  #  Without a matching checksum from the official manifest the file is not trusted.
  if [ -z "$want" ] || [ "$want" != "$have" ]; then rm -f "$tmp"; say "Stable channel: checksum of $v did not match the release manifest; not installed."; return 1; fi
  chmod +x "$tmp"
  LD_PRELOAD= "$PATCHELF" --set-interpreter "$GLIBC_LD" "$tmp" 2>/dev/null || { rm -f "$tmp"; say "Stable channel: could not prepare $v for Termux."; return 1; }
  mkdir -p "$VERSIONS/.ca-smoke-home/.claude"
  ( cd "$VERSIONS" && HOME="$VERSIONS/.ca-smoke-home" LD_PRELOAD= timeout -s KILL 45 "$tmp" --init-only < /dev/null > /dev/null 2>&1 ); local rc=$?
  rm -rf "$VERSIONS/.ca-smoke-home"
  #  A crash (killed by a signal) means this build does not run here.
  if [ "$rc" -gt 128 ] && [ "$rc" -le 159 ]; then rm -f "$tmp"; say "Stable channel: $v crashes on this phone; not installed."; return 1; fi
  mv -f "$tmp" "$VERSIONS/$v"
  say "Stable channel: installed $v (checksum matched, test start passed)."
  prune
}

#  Keeps the newest two usable versions, as the launcher itself does after an update (it cannot do it while the channel holds its
#  updates back). Skipped versions (held back or set aside by the guard) stay, so they can be released or undone without a download.
prune() {
  local n=0
  for v in $(installed); do
    skipped "$v" && continue
    n=$((n + 1))
    #  The first two usable versions stay; older ones are official downloads that can be fetched again.
    [ "$n" -le 2 ] && continue
    rm -f "$VERSIONS/$v" && say "Stable channel: removed the old version $v (the newest two are kept, as the launcher does)."
  done
}

case "${1:-status}" in
  status)
    echo "Channel: $(channel)    held back by the stable channel: $(cat "$HELD" 2>/dev/null | tr '\n' ' ')"
    echo "Installed (newest first): $(installed | tr '\n' ' ')"
    echo "Runs now: $(current)    previous usable: $(previous "$(current)")    known good (compat.json): $(known_good)"
    echo "Skipped by the launcher: $(cat "$BLOCK" 2>/dev/null | tr '\n' ' ')"
    echo "Spare copy: $(ls -1 "$KEPT" 2>/dev/null | tr '\n' ' ')"
    ;;
  check)
    check "${2:?which version?}"
    ;;
  revert)
    now=$(current); prev=$(previous "$now")
    #  Never skip the last usable version: there must be something to go back to.
    [ -n "$prev" ] || { say "Nothing to go back to: $now is the only usable version. Try restore-kept."; exit 1; }
    block "$now"
    say "Reverted: $now is skipped; the next start of Claude uses $prev. Undo: ca-claude-version unrevert $now"
    ;;
  unrevert)
    v="${2:?which version?}"
    #  Rewrite the skip list without that version (through a temporary file, so it is never half written).
    grep -vxF "$v" "$BLOCK" > "$BLOCK.new" 2>/dev/null; mv -f "$BLOCK.new" "$BLOCK"
    say "No longer skipped: $v. The next start of Claude uses $(current)."
    ;;
  keep)
    v="${2:-$(known_good)}"
    [ -f "$VERSIONS/$v" ] || { say "Cannot keep $v: it is not in $VERSIONS."; exit 1; }
    [ -f "$KEPT/$v" ] && { echo "Already kept: $v"; exit 0; }
    need=$(( $(stat -c%s "$VERSIONS/$v") / 1024 + 200000 ))
    free=$(df -k "$HOME" | awk 'NR==2 {print $4}')
    #  Refuse when the copy would leave less than about 200 MB free.
    [ "$free" -gt "$need" ] || { say "Not enough free space to keep $v."; exit 1; }
    mkdir -p "$KEPT" "$REVIEW"
    #  Only one spare is kept; an older one goes to the review folder instead of being erased.
    for old in "$KEPT"/*; do [ -f "$old" ] && mv -f "$old" "$REVIEW/" && say "Older spare moved to $REVIEW/$(basename "$old")"; done
    cp "$VERSIONS/$v" "$KEPT/$v.part" && mv -f "$KEPT/$v.part" "$KEPT/$v" && say "Kept a spare copy of $v in $KEPT"
    ;;
  restore-kept)
    v=$(ls -1 "$KEPT" 2>/dev/null | grep -E '^[0-9]+\.[0-9]+\.[0-9]+$' | head -1)
    [ -n "$v" ] || { say "There is no spare copy to restore."; exit 1; }
    #  Put the spare back unless that version is still installed.
    [ -f "$VERSIONS/$v" ] || { cp "$KEPT/$v" "$VERSIONS/$v.part" && chmod +x "$VERSIONS/$v.part" && mv -f "$VERSIONS/$v.part" "$VERSIONS/$v"; }
    grep -vxF "$v" "$BLOCK" > "$BLOCK.new" 2>/dev/null; mv -f "$BLOCK.new" "$BLOCK"
    #  Skip every newer version, so the launcher picks the restored one.
    for n in $(installed); do [ "$(printf '%s\n%s\n' "$n" "$v" | sort -V | tail -1)" = "$n" ] && [ "$n" != "$v" ] && block "$n"; done
    say "Restored the spare $v; newer versions are skipped. The next start of Claude uses $(current)."
    ;;
  guard)
    dry="${2:-}"
    now=$(current); good=$(known_good)
    #  Nothing to do for the known-good version, or for a version that was already looked at.
    if [ -z "$now" ] || [ "$now" = "$good" ] || grep -qxF "$now" "$GUARDED" 2>/dev/null; then echo "Guard: nothing new ($now)."; exit 0; fi
    result=$(check "$now"); echo "$result"
    #  A passing new version is simply remembered as looked at.
    if [ "${result%% *}" = "PASS" ]; then printf '%s\n' "$now" >> "$GUARDED"; say "Guard: $now works for PocketIris."; exit 0; fi
    prev=$(previous "$now")
    #  Revert only when the previous version passes the same check now; otherwise the version is not to blame (for example the app is closed).
    if [ -n "$prev" ] && [ "$(check "$prev" | cut -d' ' -f1)" = "PASS" ]; then
      [ "$dry" = "--dry-run" ] && { echo "Guard (dry run): would revert $now to $prev."; exit 2; }
      printf '%s\n' "$now" >> "$GUARDED"; block "$now"
      say "Guard: $now failed ($result) and $prev passes: reverted to $prev. Undo: ca-claude-version unrevert $now"
      exit 2
    fi
    #  Not remembered as looked at: the cause is elsewhere (for example the app was not running yet), so the next start checks again.
    say "Guard: $now failed but ${prev:-no previous version} does not pass either; not reverting (the cause is elsewhere); will check again next time."
    exit 1
    ;;
  current)
    #  Just the version the launcher runs now (used by ca-updates).
    current
    ;;
  install)
    v="${2:?which version?}"
    #  Installs one official build on request (the Updates button on the stable channel); the launcher picks it if it is the newest usable one.
    [ -f "$VERSIONS/$v" ] && { echo "Already installed: $v"; exit 0; }
    fetch "$v" || exit 1
    #  A version on the skip list would never run; installing it on purpose clears that.
    unblock "$v"; grep -vxF "$v" "$HELD" > "$HELD.new" 2>/dev/null; mv -f "$HELD.new" "$HELD" 2>/dev/null
    echo "Installed $v; it runs from the next start of Claude."
    ;;
  channel)
    #  With a choice given, write it into settings.conf (replacing an earlier choice), then show the channel in use.
    if [ -n "${2:-}" ]; then
      case "$2" in latest|stable) ;; *) echo "Choose latest or stable."; exit 1 ;; esac
      touch "$SETTINGS"
      if grep -q '^CLAUDE_CHANNEL=' "$SETTINGS"; then sed -i "s/^CLAUDE_CHANNEL=.*/CLAUDE_CHANNEL=$2/" "$SETTINGS"
      else printf '# Claude Code updates: latest (every release, as the launcher does) or stable (only releases Anthropic marks stable):\nCLAUDE_CHANNEL=%s\n' "$2" >> "$SETTINGS"; fi
      say "Claude Code channel set to $2. It applies at the next server or app start, or now with: ca-claude-version follow"
    fi
    echo "Channel: $(channel)"
    ;;
  follow)
    #  The latest channel is what the launcher does by itself: release every hold this command made.
    if [ "$(channel)" = latest ]; then
      for v in $(cat "$HELD" 2>/dev/null); do unblock "$v"; say "Latest channel: released $v."; done
      : > "$HELD" 2>/dev/null
      exit 0
    fi
    #  On the stable channel this command does the updating: refreshing the launcher's own "last checked" stamp keeps its daily check
    #  (which only knows "latest") from running first. --quick does only that, with no network, so it can run before anything starts Claude.
    touch "$VERSIONS/.last-update-check"
    [ "${2:-}" = "--quick" ] && exit 0
    s=$(tag stable); l=$(tag latest)
    #  Without an answer from npm nothing is changed; the next start tries again.
    [ -n "$s" ] || { echo "Stable channel: npm did not answer; nothing changed."; exit 0; }
    now=$(current)
    #  Nothing installed at all is the launcher's job (first install), not this command's.
    [ -n "$now" ] || { echo "Stable channel: no version installed yet."; exit 0; }
    ceiling=$s; newer "$now" "$ceiling" && ceiling=$now
    #  Release holds that Anthropic has now marked stable (or that are not newer than what already runs).
    for v in $(cat "$HELD" 2>/dev/null); do
      newer "$v" "$ceiling" && continue
      unblock "$v"; grep -vxF "$v" "$HELD" > "$HELD.new"; mv -f "$HELD.new" "$HELD"
      say "Stable channel: released $v (stable is now $s)."
    done
    #  Fetch the stable build when it is newer than what runs and the launcher will not fetch it (it only ever fetches "latest").
    if newer "$s" "$now" && [ ! -f "$VERSIONS/$s" ]; then fetch "$s" || exit 1; fi
    #  Hold back the latest release while it is newer than both stable and what runs; never anything older, so nothing moves backwards.
    for v in $l; do
      newer "$v" "$ceiling" || continue
      skipped "$v" && continue
      block "$v"; printf '%s\n' "$v" >> "$HELD"
      say "Stable channel: holding back $v until Anthropic marks it stable (stable is $s; $(current) runs)."
    done
    ;;
  *) sed -n '2,16p' "$0"; exit 1 ;;
esac
